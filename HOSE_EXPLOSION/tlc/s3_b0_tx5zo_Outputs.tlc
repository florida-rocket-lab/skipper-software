    skipper_lqi_for_export_B.state_with_error[i] = skipper_lqi_for_export_P.DiscreteIntegrator_gainval * skipper_lqi_for_export_B.state_with_error_derivative[i] + skipper_lqi_for_export_DW.DiscreteIntegrator_DSTATE[i];
