for (i_0 = 0; i_0 < 12; i_0++) {
    /* {S!d52}Gain: '<Root>/state_gain' */
    UnitDelay = 0.0;
    for (i = 0; i < 12; i++) {
        UnitDelay += skipper_lqi_for_export_P.A[12 * i + i_0] * skipper_lqi_for_export_B.state_with_perturbation[i];
