fb_error_control = skipper_lqi_for_export_B.Reshapeu[3];
for (i_0 = 0; i_0 < 12; i_0++) {
    passthrough_gain = tmp_1[i_0] * UnitDelay;
    passthrough_gain += tmp_1[i_0 + 12] * state_with_error;
    passthrough_gain += tmp_1[i_0 + 24] * state_with_error_0;
    passthrough_gain += tmp_1[i_0 + 36] * fb_error_control;
    /* {S!d170}Product: '<S23>/B[k]*u[k]' */
    skipper_lqi_for_export_B.Bkuk[i_0] = passthrough_gain;
}
/* {E!d172}End of Product: '<S23>/B[k]*u[k]' */

/* {S!d35}Outputs for Enabled SubSystem: '<S23>/MeasurementUpdate' incorporates:
 *  EnablePort: '<S54>/Enable'
 */
/* {S!d192}Constant: '<S1>/Enable' */
if (skipper_lqi_for_export_P.Enable_Value) {
    skipper_lqi_for_export_DW.MeasurementUpdate_MODE = true;
    /* {S!d36}Outputs for Enabled SubSystem: '<S30>/Enabled Subsystem' incorporates:
 *  EnablePort: '<S56>/Enable'
 */
    /* {S!d176}Product: '<S54>/C[k]*xhat[k|k-1]' incorporates:
 *  Constant: '<S1>/C'
 *  Product: '<S23>/A[k]*xhat[k|k-1]'
 *  Product: '<S54>/Product3'
 *  Product: '<S56>/Product'
 *  Product: '<S56>/Product2'
 */
    tmp_2 = &skipper_lqi_for_export_P.C_Value[0];
    /* {E!d36}End of Outputs for SubSystem: '<S30>/Enabled Subsystem' */
    std::memcpy(&tmp_0[0], &skipper_lqi_for_export_B.MemoryX[0], 12U * sizeof(real_T));
    for (i_0 = 0; i_0 < 12; i_0++) {
        passthrough_gain = 0.0;
        for (i = 0; i < 12; i++) {
            passthrough_gain += tmp_2[12 * i + i_0] * tmp_0[i];
        }
        /* {S!d174}Product: '<S54>/C[k]*xhat[k|k-1]' */
        skipper_lqi_for_export_B.Ckxhatkk1[i_0] = passthrough_gain;
    }
    /* {S!d184}Product: '<S54>/D[k]*u[k]' incorporates:
 *  Constant: '<S1>/D'
 */
    std::memcpy(&tmp_1[0], &skipper_lqi_for_export_P.D_Value[0], 48U * sizeof(real_T));
    for (i = 0; i < 12; i++) {
        passthrough_gain = tmp_1[i] * UnitDelay;
        passthrough_gain += tmp_1[i + 12] * state_with_error;
        passthrough_gain += tmp_1[i + 24] * state_with_error_0;
        passthrough_gain += tmp_1[i + 36] * fb_error_control;
        /* {S!d178}Product: '<S54>/D[k]*u[k]' */
        skipper_lqi_for_export_B.Dkuk[i] = passthrough_gain;
        /* {S!d180}Sum: '<S54>/Add1' */
        passthrough_gain += skipper_lqi_for_export_B.Ckxhatkk1[i];
        skipper_lqi_for_export_B.yhatkk1[i] = passthrough_gain;
        /* {S!d182}Sum: '<S54>/Sum' incorporates:
 *  Inport: '<Root>/imu_state_in'
 */
        skipper_lqi_for_export_B.Sum[i] = skipper_lqi_for_export_U.imu_state_in[i] - passthrough_gain;
    }
    /* {E!d184}End of Product: '<S54>/D[k]*u[k]' */

    /* {S!d38}Outputs for Enabled SubSystem: '<S30>/Enabled Subsystem' incorporates:
 *  EnablePort: '<S56>/Enable'
 */
    /* {S!d188}Product: '<S54>/Product3' incorporates:
 *  Constant: '<S3>/KalmanGainL'
 *  Product: '<S23>/A[k]*xhat[k|k-1]'
 *  Product: '<S54>/C[k]*xhat[k|k-1]'
 *  Product: '<S56>/Product'
 *  Product: '<S56>/Product2'
 */
    tmp_2 = &skipper_lqi_for_export_P.KalmanGainL_Value[0];
    /* {E!d38}End of Outputs for SubSystem: '<S30>/Enabled Subsystem' */
    std::memcpy(&tmp_0[0], &skipper_lqi_for_export_B.Sum[0], 12U * sizeof(real_T));
    for (i_0 = 0; i_0 < 12; i_0++) {
        passthrough_gain = 0.0;
        for (i = 0; i < 12; i++) {
            passthrough_gain += tmp_2[12 * i + i_0] * tmp_0[i];
        }
        /* {S!d186}Product: '<S54>/Product3' */
        skipper_lqi_for_export_B.Product3[i_0] = passthrough_gain;
    }
} else if (skipper_lqi_for_export_DW.MeasurementUpdate_MODE) {
    for (i = 0; i < 12; i++) {
        /* {S!d190}Disable for Product: '<S54>/Product3' incorporates:
 *  Outport: '<S54>/L*(y[k]-yhat[k|k-1])'
 */
        skipper_lqi_for_export_B.Product3[i] = skipper_lqi_for_export_P.Lykyhatkk1_Y0;
    }
    skipper_lqi_for_export_DW.MeasurementUpdate_MODE = false;
}
/* {E!d35}End of Outputs for SubSystem: '<S23>/MeasurementUpdate' */
for (i = 0; i < 12; i++) {
    /* {S!d194}Sum: '<S23>/Add' */
    skipper_lqi_for_export_B.Add[i] = (skipper_lqi_for_export_B.Bkuk[i] + skipper_lqi_for_export_B.Akxhatkk1[i]) + skipper_lqi_for_export_B.Product3[i];
}
/* {S!d41}Outputs for Enabled SubSystem: '<S30>/Enabled Subsystem' incorporates:
 *  EnablePort: '<S56>/Enable'
 */
/* {S!d208}Constant: '<S1>/Enable' */
if (skipper_lqi_for_export_P.Enable_Value) {
    skipper_lqi_for_export_DW.EnabledSubsystem_MODE = true;
    /* {S!d42}Outputs for Enabled SubSystem: '<S23>/MeasurementUpdate' incorporates:
 *  EnablePort: '<S54>/Enable'
 */
    /* {S!d200}Product: '<S56>/Product' incorporates:
 *  Constant: '<S1>/C'
 *  Product: '<S23>/A[k]*xhat[k|k-1]'
 *  Product: '<S54>/C[k]*xhat[k|k-1]'
 *  Product: '<S54>/Product3'
 *  Product: '<S56>/Product2'
 */
    tmp_2 = &skipper_lqi_for_export_P.C_Value[0];
    /* {E!d42}End of Outputs for SubSystem: '<S23>/MeasurementUpdate' */
    std::memcpy(&tmp_0[0], &skipper_lqi_for_export_B.MemoryX[0], 12U * sizeof(real_T));
    for (i = 0; i < 12; i++) {
        UnitDelay = 0.0;
        for (i_0 = 0; i_0 < 12; i_0++) {
            UnitDelay += tmp_2[12 * i_0 + i] * tmp_0[i_0];
        }
        /* {S!d196}Product: '<S56>/Product' */
        skipper_lqi_for_export_B.Product[i] = UnitDelay;
        /* {S!d198}Sum: '<S56>/Add1' incorporates:
 *  Inport: '<Root>/imu_state_in'
 */
        skipper_lqi_for_export_B.Add1[i] = skipper_lqi_for_export_U.imu_state_in[i] - UnitDelay;
    }
    /* {S!d44}Outputs for Enabled SubSystem: '<S23>/MeasurementUpdate' incorporates:
 *  EnablePort: '<S54>/Enable'
 */
    /* {S!d204}Product: '<S56>/Product2' incorporates:
 *  Constant: '<S3>/KalmanGainM'
 *  Product: '<S23>/A[k]*xhat[k|k-1]'
 *  Product: '<S54>/C[k]*xhat[k|k-1]'
 *  Product: '<S54>/Product3'
 *  Product: '<S56>/Product'
 */
    tmp_2 = &skipper_lqi_for_export_P.KalmanGainM_Value[0];
    /* {E!d44}End of Outputs for SubSystem: '<S23>/MeasurementUpdate' */
    std::memcpy(&tmp_0[0], &skipper_lqi_for_export_B.Add1[0], 12U * sizeof(real_T));
    for (i_0 = 0; i_0 < 12; i_0++) {
        passthrough_gain = 0.0;
        for (i = 0; i < 12; i++) {
            passthrough_gain += tmp_2[12 * i + i_0] * tmp_0[i];
        }
        /* {S!d202}Product: '<S56>/Product2' */
        skipper_lqi_for_export_B.Product2[i_0] = passthrough_gain;
    }
} else if (skipper_lqi_for_export_DW.EnabledSubsystem_MODE) {
    for (i = 0; i < 12; i++) {
        /* {S!d206}Disable for Product: '<S56>/Product2' incorporates:
 *  Outport: '<S56>/deltax'
 */
        skipper_lqi_for_export_B.Product2[i] = skipper_lqi_for_export_P.deltax_Y0;
    }
    skipper_lqi_for_export_DW.EnabledSubsystem_MODE = false;
}
/* {E!d41}End of Outputs for SubSystem: '<S30>/Enabled Subsystem' */

/* {S!d210}Gain: '<Root>/input_gain' incorporates:
 *  Outport: '<Root>/control_commands_out'
 */
UnitDelay = skipper_lqi_for_export_Y.control[0];
state_with_error = skipper_lqi_for_export_Y.control[1];
state_with_error_0 = skipper_lqi_for_export_Y.control[2];
fb_error_control = skipper_lqi_for_export_Y.control[3];
for (i = 0; i < 12; i++) {
    /* {S!d212}Sum: '<S30>/Add' */
    passthrough_gain = skipper_lqi_for_export_B.Product2[i] + skipper_lqi_for_export_B.MemoryX[i];
    skipper_lqi_for_export_B.Add_j[i] = passthrough_gain;
    /* {S!d214}Gain: '<Root>/input_gain' incorporates:
 *  Outport: '<Root>/control_commands_out'
 */
    input_gain = skipper_lqi_for_export_P.B[i] * UnitDelay;
    input_gain += skipper_lqi_for_export_P.B[i + 12] * state_with_error;
    input_gain += skipper_lqi_for_export_P.B[i + 24] * state_with_error_0;
    input_gain += skipper_lqi_for_export_P.B[i + 36] * fb_error_control;
    skipper_lqi_for_export_B.input_gain[i] = input_gain;
    /* {S!d216}Update for UnitDelay: '<Root>/Unit Delay' */
    skipper_lqi_for_export_DW.UnitDelay_DSTATE[i] = passthrough_gain;
    /* {S!d218}Update for UnitDelay: '<Root>/Unit Delay1' */
    skipper_lqi_for_export_DW.UnitDelay1_DSTATE[i] = input_gain;
}
/* {S!d220}Update for DiscreteIntegrator: '<Root>/Discrete Integrator' incorporates:
 *  Sum: '<Root>/state_derivative_sum'
 */
for (i = 0; i < 15; i++) {
    skipper_lqi_for_export_DW.DiscreteIntegrator_DSTATE[i] = skipper_lqi_for_export_P.DiscreteIntegrator_gainval * skipper_lqi_for_export_B.state_with_error_derivative[i] + skipper_lqi_for_export_B.state_with_error[i];
}
/* {E!d220}End of Update for DiscreteIntegrator: '<Root>/Discrete Integrator' */

/* {S!d222}Update for Delay: '<S1>/MemoryX' */
skipper_lqi_for_export_DW.icLoad = false;
std::memcpy(&skipper_lqi_for_export_DW.MemoryX_DSTATE[0], &skipper_lqi_for_export_B.Add[0], 12U * sizeof(real_T));
